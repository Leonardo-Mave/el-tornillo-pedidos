        "message": "=<div style='background:#f4f5f7;padding:24px 12px;font-family:Arial,Helvetica,sans-serif;color:#222222'><table role='presentation' align='center' width='100%' style='max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border-collapse:collapse'><tr><td style='background:{{ $json.Urgencia === 'Hoy' ? '#c00000' : '#2e7d32' }};padding:16px 28px;color:#ffffff;font-size:16px;font-weight:bold;border-radius:8px 8px 0 0'>{{ $json.Urgencia === 'Hoy' ? '🔴 URGENTE: responder hoy' : '🟢 Nueva consulta' }}</td></tr><tr><td style='padding:28px'><div style='font-size:12px;letter-spacing:1px;color:#888888'>SISTEMA DE PEDIDOS · EL TORNILLO</div><div style='font-size:20px;font-weight:bold;color:#1F3864;margin:6px 0 4px'>Nuevo {{ $json.Tipo.toLowerCase() }} de {{ $json.Cliente }}</div><div style='font-size:14px;color:#666666;margin-bottom:20px'>N° <b>{{ $json.ID }}</b> · {{ $json['Fecha y hora'] }}</div><table role='presentation' width='100%' style='border-collapse:collapse;font-size:14px'><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777;width:34%'>Cliente</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'><b>{{ $json.Cliente }}</b></td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Contacto</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'><a href='mailto:{{ $json.Mail }}' style='color:#1a56c4'>{{ $json.Mail }}</a><br>{{ $json['Teléfono'] || 'Teléfono no indicado' }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Tipo / Rubro</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Tipo }} / {{ $json.Rubro }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Detalle</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Detalle }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Cantidad</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Cantidad }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Entrega</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Entrega }}</td></tr><tr><td style='padding:10px 0;color:#777777'>Urgencia</td><td style='padding:10px 0'><span style='display:inline-block;padding:3px 12px;border-radius:12px;font-size:12px;font-weight:bold;background:{{ $json.Urgencia === 'Hoy' ? '#fde8e8' : '#e3f4e6' }};color:{{ $json.Urgencia === 'Hoy' ? '#c00000' : '#1e7b34' }}'>{{ $json.Urgencia }}</span></td></tr></table><table role='presentation' style='border-collapse:collapse;margin:24px 0 18px'><tr><td style='background:#1F3864;border-radius:6px'><a href='https://docs.google.com/spreadsheets/d/TU_ID_DE_PLANILLA/edit' style='display:inline-block;padding:12px 22px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:14px'>Abrir planilla de pedidos</a></td></tr></table><p style='margin:0;font-size:14px;color:#555555'>La consulta ya quedó cargada en la planilla. Para tomarla, cambiá el <b>Estado</b> a <b>En proceso</b> y asignate como <b>Responsable</b>.</p></td></tr><tr><td style='background:#f4f5f7;padding:16px 28px;font-size:12px;color:#999999;text-align:center;border-radius:0 0 8px 8px'>Mail automático de demostración. Negocio ficticio.</td></tr></table></div>",
        "options": {
