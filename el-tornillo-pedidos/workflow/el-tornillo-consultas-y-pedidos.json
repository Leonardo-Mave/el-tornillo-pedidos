    {
      "parameters": {
        "sendTo": "={{ $json.Mail }}",
        "subject": "=Recibimos tu consulta ({{ $json.ID }}) — El Tornillo",
        "message": "=<div style='background:#f4f5f7;padding:24px 12px;font-family:Arial,Helvetica,sans-serif;color:#222222'><table role='presentation' align='center' width='100%' style='max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border-collapse:collapse'><tr><td style='background:#1F3864;padding:22px 28px;color:#ffffff;border-radius:8px 8px 0 0'><div style='font-size:20px;font-weight:bold'>Ferretería y Repuestos El Tornillo</div><div style='font-size:13px;color:#c9d6ee;margin-top:4px'>Confirmación de tu consulta</div></td></tr><tr><td style='padding:28px'><p style='margin:0 0 6px;font-size:16px'>Hola <b>{{ $json.Cliente }}</b>,</p><p style='margin:0 0 20px;font-size:15px;color:#444444'>¡Gracias por escribirnos! Ya recibimos tu consulta y quedó registrada.</p><table role='presentation' width='100%' style='border-collapse:collapse;margin-bottom:24px'><tr><td style='background:#eef3fb;text-align:center;padding:18px;border-radius:8px'><div style='font-size:12px;letter-spacing:1px;color:#5a6b8c'>N° DE CONSULTA</div><div style='font-size:26px;font-weight:bold;color:#1F3864;margin-top:4px'>{{ $json.ID }}</div></td></tr></table><div style='font-size:12px;letter-spacing:1px;color:#888888;margin-bottom:6px'>RESUMEN DE TU PEDIDO</div><table role='presentation' width='100%' style='border-collapse:collapse;font-size:14px;margin-bottom:24px'><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777;width:38%'>Tipo de consulta</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'><b>{{ $json.Tipo }}</b></td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Rubro</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Rubro }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Detalle</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Detalle }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Cantidad</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Cantidad }}</td></tr><tr><td style='padding:10px 0;border-bottom:1px solid #e6e6e6;color:#777777'>Entrega</td><td style='padding:10px 0;border-bottom:1px solid #e6e6e6'>{{ $json.Entrega }}</td></tr><tr><td style='padding:10px 0;color:#777777'>Urgencia</td><td style='padding:10px 0'><span style='display:inline-block;padding:3px 12px;border-radius:12px;font-size:12px;font-weight:bold;background:{{ $json.Urgencia === 'Hoy' ? '#fde8e8' : '#e3f4e6' }};color:{{ $json.Urgencia === 'Hoy' ? '#c00000' : '#1e7b34' }}'>{{ $json.Urgencia }}</span></td></tr></table><table role='presentation' width='100%' style='border-collapse:collapse;margin-bottom:20px'><tr><td style='background:#fff8e6;border-left:4px solid #f0b429;padding:14px 16px;font-size:14px'><b>¿Qué sigue?</b><br>{{ $json.Urgencia === 'Hoy' ? 'Como marcaste urgencia, te respondemos hoy antes de las 18 hs.' : $json.Urgencia === 'Esta semana' ? 'Te respondemos dentro de las próximas 24 hs hábiles.' : 'Te respondemos dentro de los próximos 2 días hábiles.' }}</td></tr></table><p style='margin:0;font-size:14px;color:#555555'>Si necesitás cambiar algo, respondé este mail indicando el número <b>{{ $json.ID }}</b>.</p></td></tr><tr><td style='background:#f4f5f7;padding:18px 28px;font-size:12px;color:#777777;text-align:center;border-radius:0 0 8px 8px'><b>Equipo de Ferretería y Repuestos El Tornillo</b><br>Lunes a viernes de 8 a 12 y de 16 a 20 · Sábados de 8 a 13<br><span style='color:#999999'>Mail automático de demostración. Negocio ficticio.</span></td></tr></table></div>",
