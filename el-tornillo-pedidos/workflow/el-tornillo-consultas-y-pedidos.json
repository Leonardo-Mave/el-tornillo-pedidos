                  {
                    "option": "Repuestos auto/moto"
                  },
                  {
                    "option": "Herramientas"
                  },
                  {
                    "option": "Otros"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Detalle de lo que necesitás",
              "fieldType": "textarea",
              "fieldName": "detalle",
              "placeholder": "Ej: pastillas de freno delanteras para Gol Trend 2014",
              "requiredField": true
            },
            {
              "fieldLabel": "Cantidad",
              "fieldType": "number",
              "fieldName": "cantidad"
            },
            {
              "fieldLabel": "Urgencia",
              "fieldType": "dropdown",
              "fieldName": "urgencia",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Hoy"
                  },
                  {
                    "option": "Esta semana"
                  },
                  {
                    "option": "Sin apuro"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Retira en local o envío",
              "fieldType": "dropdown",
              "fieldName": "entrega",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Retira en local"
                  },
                  {
                    "option": "Envío"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Enviar consulta",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "¡Gracias! Recibimos tu consulta. Te enviamos un mail de confirmación."
            }
          },
          "path": "el-tornillo-pedidos"
        }
      },
