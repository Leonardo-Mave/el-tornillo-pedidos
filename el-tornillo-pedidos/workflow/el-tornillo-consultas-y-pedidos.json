            {
              "fieldLabel": "Teléfono / WhatsApp",
              "fieldName": "telefono"
            },
            {
              "fieldLabel": "Tipo de consulta",
              "fieldType": "dropdown",
              "fieldName": "tipo",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Presupuesto"
                  },
                  {
                    "option": "Disponibilidad"
                  },
                  {
                    "option": "Pedido"
                  },
                  {
                    "option": "Reclamo"
                  }
